# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnpm-store/

# env files (never commit local/real values)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
/supabase/.temp
/supabase/.branches
/.swc

# Generated by the Workflow compiler (`withWorkflow`) at build time.
src/app/.well-known/workflow/

# Playwright (Sprint 11C.1). Traces and screenshots can contain whatever was on
# screen, so they stay local and out of the repository by default.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Claude Code. The directory is NOT ignored wholesale: `.claude/skills/` is
# repo-native design tooling and has to travel with a clone (ADR 0095). What is
# ignored is the machine-specific half.
#
# The worktrees are full repository checkouts with node_modules — the set
# reached 5 GB — so this must never be picked up by `git add -A`.
.claude/worktrees/
# Per-machine permission grants and enabled-MCP toggles.
.claude/settings.local.json
.claude/*.local.json
# Local MCP secrets, sourced into the environment before launching Claude Code.
# Never committed; `docs/development/remote-design-tooling.md` says what goes in it.
.claude/mcp.env

# Registry staging area. Third-party components land here to be read and ported
# by hand; nothing vendored is committed, and nothing here is imported by the
# application (ADR 0095).
/src/components/vendor/

# Output of an external UI review tool. Regenerated on demand, and it records
# an absolute path from whichever machine produced it.
/premium-audit.json

# Paid Nova voice eval output — per-case results, never committed.
.nova-eval/

# Projekt-Atlas: aus dem Repository generierte Uebersichtsseite (pnpm atlas).
# Wird neu gebaut statt nachgefuehrt, gehoert deshalb nicht in die Historie.
/.atlas/
