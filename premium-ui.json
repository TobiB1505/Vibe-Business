{
  "profile": "product-admin",
  "sourceRoots": [
    "src/app/app/(account)/repositories",
    "src/app/app/projects/[projectId]/business-brain",
    "src/app/app/projects/[projectId]/product",
    "src/app/app/(account)/billing",
    "src/app/app/onboarding/[projectId]",
    "src/components/product-scan"
  ],
  "locale": "en",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Scrollbar"],
  "ownership": {
    "Select/Listbox": "native",
    "Scrollbar": "global"
  },
  "requiredCommands": ["unit", "e2e", "accessibility", "premium"],
  "commands": {
    "unit": "pnpm test",
    "e2e": "pnpm exec playwright test e2e/account-repositories.spec.ts e2e/business-audit.spec.ts e2e/action-plan-ui.spec.ts e2e/billing.spec.ts",
    "accessibility": "pnpm exec playwright test e2e/account-repositories.spec.ts e2e/business-audit.spec.ts e2e/action-plan-ui.spec.ts e2e/billing.spec.ts",
    "premium": "python3 <skill-dir>/scripts/audit_project.py . --mode strict --no-write"
  },
  "evidence": {
    "failurePaths": "e2e/app-error.spec.ts",
    "repositoryStates": "e2e/account-repositories.spec.ts",
    "businessHealthStates": "e2e/business-audit.spec.ts",
    "businessAuditRecovery": "e2e/action-plan-ui.spec.ts",
    "productScanStates": "e2e/product-scan.spec.ts",
    "billingStates": "e2e/billing.spec.ts"
  }
}
