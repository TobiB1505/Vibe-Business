# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit
# .env.local or any file containing real values — see ADR 0008.

# Public — safe to expose to the browser (Next.js inlines NEXT_PUBLIC_*
# variables into the client bundle by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — GitHub App configuration (ADR 0003, ADR 0009). Required only
# by src/modules/github/ (repository connect flow). Never expose any of
# these through NEXT_PUBLIC_*. See docs/setup/github-app.md for exactly how
# to obtain each value from the GitHub App's settings page.
#
# GITHUB_APP_ID is the App ID (a small number, e.g. 123456) — distinct from
# GITHUB_APP_CLIENT_ID (the OAuth Client ID, e.g. Iv1.xxxxxxxxxxxxxxxx) and
# from any installation_id, which is per-installation and never configured
# here (see docs/setup/github-app.md for the full distinction).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The App's private key (PEM, generated once in the GitHub App settings and
# downloaded as a .pem file). Paste it as a single line with literal \n in
# place of real line breaks — src/lib/env/github.ts converts \n back to real
# newlines automatically. Example shape (not a real key):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
# On Vercel, its environment variable UI supports real multiline values
# directly — paste the .pem file's contents as-is there instead.
GITHUB_APP_PRIVATE_KEY=

# Server-only — Anthropic API key (ADR 0005, ADR 0008). Required only by the
# Business Readiness Audit (src/modules/ai/). Create one at
# https://console.anthropic.com/settings/keys. Never expose it through
# NEXT_PUBLIC_*, never commit a real value, and never paste it into
# documentation. Build, tests and CI all run without it — only an actual
# audit request needs a real key.
ANTHROPIC_API_KEY=

# No other server-only secrets are required yet. SUPABASE_SERVICE_ROLE_KEY is
# intentionally omitted until a feature actually needs it — see
# src/lib/env/README.md.
