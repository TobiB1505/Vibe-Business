# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit
# .env.local or any file containing real values — see ADR 0008.

# Public — safe to expose to the browser (Next.js inlines NEXT_PUBLIC_*
# variables into the client bundle by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- This deployment's own URL (src/lib/env/app-url.ts) --------------------
# Optional. Set this only in Vercel's Production environment, to your custom
# production domain (e.g. https://your-production-domain.com). Leave unset
# everywhere else:
#   - Local development falls back to http://localhost:3000.
#   - Preview deployments resolve it automatically from Vercel's own
#     VERCEL_URL (a fresh, unique host per deployment) — do NOT set a fixed
#     "preview URL" here, it would be wrong for every deployment but the one
#     it was copied from.
# Used for the sitemap, robots.txt, metadataBase, and the Stripe Checkout
# return-URL fallback. See docs/deployment/environment.md.
#
# NOT the same variable as VIBE_AGENT_GATEWAY_ORIGIN below — that one is a
# security boundary (a Vercel Sandbox's entire egress allowlist) and stays
# independently configured on purpose; see its own comment.
NEXT_PUBLIC_APP_URL=

# Server-only — GitHub App configuration (ADR 0003, ADR 0009). Required only
# by src/modules/github/ (repository connect flow). Never expose any of
# these through NEXT_PUBLIC_*. See docs/setup/github-app.md for exactly how
# to obtain each value from the GitHub App's settings page.
#
# GITHUB_APP_ID is the App ID (a small number, e.g. 123456) — distinct from
# GITHUB_APP_CLIENT_ID (the OAuth Client ID, e.g. Iv1.xxxxxxxxxxxxxxxx) and
# from any installation_id, which is per-installation and never configured
# here (see docs/setup/github-app.md for the full distinction).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The App's private key (PEM, generated once in the GitHub App settings and
# downloaded as a .pem file). Paste it as a single line with literal \n in
# place of real line breaks — src/lib/env/github.ts converts \n back to real
# newlines automatically. Example shape (not a real key):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
# On Vercel, its environment variable UI supports real multiline values
# directly — paste the .pem file's contents as-is there instead.
GITHUB_APP_PRIVATE_KEY=

# Server-only — Anthropic API key (ADR 0005, ADR 0008). Required only by the
# Business Readiness Audit (src/modules/ai/). Create one at
# https://console.anthropic.com/settings/keys. Never expose it through
# NEXT_PUBLIC_*, never commit a real value, and never paste it into
# documentation. Build, tests and CI all run without it — only an actual
# audit request needs a real key.
ANTHROPIC_API_KEY=

# --- Agent Gateway (EXECUTION CORE-4, required for agentic execution) ------
# The Claude Agent SDK spawns a ~325 MB native binary, so it runs inside the
# execution's own Vercel Sandbox rather than in a function. A sandbox that
# executes a customer's repository is the last place ANTHROPIC_API_KEY may be,
# so the sandbox instead gets a short-lived, execution-scoped token and an
# ANTHROPIC_BASE_URL pointing at Vibe's own gateway, which injects the real key
# outside the VM (Anthropic, "Secure deployment" -> the proxy pattern).
#
# The origin must be the https URL of THIS deployment as reachable from the
# public internet, with no path. It becomes the sandbox's entire egress
# allowlist, so a wrong value is both a wrong destination and a hole in the
# network policy. It is never guessed from VERCEL_URL: that would point a
# production execution at whatever deployment happened to run the workflow.
VIBE_AGENT_GATEWAY_ORIGIN=
# Server-only HMAC signing secret for those tokens. Any high-entropy random
# string (e.g. `openssl rand -base64 48`). Never NEXT_PUBLIC_, never inside a
# sandbox, never logged. Rotating it invalidates every token in flight, which
# is the intended emergency stop. Without both of these set, the gateway
# refuses every request and an agent run fails before it buys a VM.
VIBE_AGENT_GATEWAY_SECRET=

# --- Supabase service role (Sprint 7, required for durable execution) ------
# Workflow steps run outside any HTTP request, so there is no cookie session
# and no auth.uid() for RLS to act on. This key is what lets a step read and
# write operation state; the ownership checks RLS would have made are enforced
# in code instead — see ADR 0013 and src/lib/supabase/service.ts.
#
# Server-only: never NEXT_PUBLIC_, never in the client bundle, never logged.
# lint / typecheck / test / build and CI all run without it.
# Supabase Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Browserbase (Sprint 5, optional) --------------------------------------
# Required only to start an authenticated product analysis. Server-only:
# never NEXT_PUBLIC_, never in the client bundle, never in the database or a
# log. lint / typecheck / test / build and CI all run without it.
# Get one at https://www.browserbase.com/settings
BROWSERBASE_API_KEY=
# Optional. Omit to let the SDK infer the project from the API key.
BROWSERBASE_PROJECT_ID=

# --- Sentry error monitoring + tracing (ADR 0022) ----------------------
# Both runtime DSNs point at the same Sentry project. A DSN identifies the
# destination and is safe for browser use; it is not an account/API token.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Non-secret deployment label shared by browser, Node and Edge events.
# Recommended values on Vercel: production, preview, or development.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time source-map/release configuration. SENTRY_AUTH_TOKEN is secret and
# must exist only in local/Vercel secret storage. Org/project/release are not
# secrets. SENTRY_RELEASE may be omitted on Vercel to use its Git commit SHA.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# --- Stripe (BILLING CORE-2, ADR 0025) --------------------------------------
# Payment rail only. Stripe funds Vibe Credit balances; it is never asked at
# runtime whether a customer can afford an operation — that is the Credit
# ledger's answer. See docs/sprints/0038-billing-core2-stripe-entitlements.md.
#
# Server-only, both of them. Never NEXT_PUBLIC_, never in the client bundle,
# never logged, never in the database. The secret key can charge customers and
# the webhook signing secret can forge a payment event, which is the same thing
# as minting Credits. lint / typecheck / test / build and CI all run without
# any of these.
#
# TEST MODE FIRST. A key beginning sk_test_ is test mode. A live key is
# refused unless STRIPE_ALLOW_LIVE_MODE is also set to exactly "true" — see the
# production activation checklist in the sprint document before setting it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The approved catalog's Stripe Price ids, created in the Stripe dashboard.
# Configuration rather than code because they differ between test and live
# mode. The Credit amounts are NOT configured here — they live in
# src/modules/billing/catalog.ts, so whoever can edit Stripe cannot mint Vibe
# Credits. Each must match the catalog's euro price:
#   Builder  €19/month    Pro  €49/month
#   500 Credits €12       1,500 Credits €33       5,000 Credits €99
STRIPE_PRICE_BUILDER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_1500=
STRIPE_PRICE_PACK_5000=

# Where Stripe returns a customer after Checkout or the Customer Portal.
# e.g. https://your-deployment.example.com/app/billing
STRIPE_BILLING_RETURN_URL=

# Set to exactly "true" only after completing the production activation
# checklist. Without it, a live-mode secret key is refused at startup.
STRIPE_ALLOW_LIVE_MODE=

# --- Agentic execution (EXECUTION CORE-4, ADR 0027) -------------------------
# The projects permitted to run the internal CORE-4 dogfood coding agent, as a
# comma-separated list of project UUIDs.
#
# Absent or empty means NOBODY, which is the correct production default: no
# customer-facing Agent Credit price is approved, so no customer project may
# start an agent. A project listed here resolves the internal, explicitly
# non-production dogfood budget instead — a hard ceiling that exists to exercise
# reserve → spend → settle/release and to collect a first real cost baseline.
#
# Adding a project here is an operator decision that authorizes real provider
# spend against Vibe's own Anthropic account. Server-only: never NEXT_PUBLIC_.
VIBE_INTERNAL_AGENT_DOGFOOD_PROJECT_IDS=

# The project the dev-only preflight harness reads (`pnpm agent:preflight`).
# Read-only and spends nothing; it resolves a real plan, builds the real spec
# and prints what an agent would be permitted to do. Not used at runtime.
VIBE_DOGFOOD_PROJECT_ID=
