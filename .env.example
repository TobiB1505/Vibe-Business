# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit
# .env.local or any file containing real values — see ADR 0008.

# Public — safe to expose to the browser (Next.js inlines NEXT_PUBLIC_*
# variables into the client bundle by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No server-only secrets are required yet. Sprint 0's auth flow uses only
# the anon key via cookie-based sessions (see src/lib/supabase/server.ts).
# SUPABASE_SERVICE_ROLE_KEY and other server-only secrets (GitHub App
# private key, Anthropic API key, ...) are intentionally omitted until a
# feature actually needs them — see src/lib/env/README.md.
