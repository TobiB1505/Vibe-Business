{
  "name": "vibe-business",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe Business — the business layer for AI-built products.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "ai:probe-audit-schema": "vitest run --config vitest.probe.config.mts src/modules/ai/probe",
    "ai:dogfood-action-plan": "vitest run --config vitest.probe.config.mts src/modules/action-plans",
    "billing:dogfood": "vitest run --config vitest.probe.config.mts src/modules/credits",
    "execution:dogfood": "vitest run --config vitest.probe.config.mts src/modules/execution-contract",
    "agent:preflight": "vitest run --config vitest.probe.config.mts src/modules/coding-agent",
    "agent:canary": "vitest run --config vitest.canary.config.mts",
    "agent:dogfood": "vitest run --config vitest.probe.config.mts src/modules/coding-agent/dogfood/",
    "db:status": "supabase migration list",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --linked",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@browserbasehq/sdk": "2.16.0",
    "@octokit/auth-app": "8.3.0",
    "@octokit/oauth-methods": "6.0.2",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.0",
    "octokit": "5.0.5",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "typescript": "^5",
    "workflow": "4.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "vitest": "4.1.10"
  }
}
